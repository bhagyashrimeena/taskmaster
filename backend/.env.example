# Recommended local/prod path: Agent Platform with Application Default Credentials.
# Run: gcloud auth application-default login
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Optional alternative for Gemini Developer API mode. Never commit a real key.
GOOGLE_API_KEY=

# The hackathon uses a safe, deterministic provider behind the provider-neutral contract.
PORTFOLIO_PROVIDER=simulated
NEWS_PROVIDER=google_search
SIMULATION_MODE=normal
SIMULATION_SCENARIO_ID=hdfc-company-shock
NEWS_CANDIDATE_COUNT=20
NEWS_CACHE_TTL_SECONDS=900

ZERODHA_MCP_URL=https://mcp.kite.trade/mcp
ZERODHA_MCP_TIMEOUT_SECONDS=15
ADK_MODEL=gemini-3.5-flash
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore
TTS_LANGUAGE_CODE=en-IN

# Phase 6: disabled (manual/API), real (clock scheduler), or demo.
DAY_SCHEDULE_MODE=disabled
DAY_SCHEDULE_TIMEZONE=Asia/Kolkata
DEMO_DAY_DURATION_SECONDS=72
DEMO_STEP_TIMEOUT_SECONDS=45

# Phase 7: demo simulates a reviewed send and reply. Gmail uses ADC with gmail.send scope.
ADVISOR_PROVIDER=demo
ADVISOR_NAME=Ananya Rao
ADVISOR_EMAIL=advisor@example.com
ADVISOR_FIRM=Independent Wealth Advisor
ADVISOR_SENDER_EMAIL=
ADVISOR_DEMO_REPLY_DELAY_SECONDS=5
ADVISOR_SEND_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
